<?xml version="1.0" encoding="utf-8"?>
<!-- 扁条组合：最矮时只显示动作或进度，稍高时补充设备名和积分状态。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_surface_bg"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/combo_btn_device"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/btn_device_tonal"
        android:foreground="@drawable/widget_press_ripple">

        <ImageView
            android:id="@+id/combo_icon_device"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_water_drop"
            android:tint="@color/widget_on_device_container"
            tools:ignore="ContentDescription,UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/combo_title_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动设备"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_device_container"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/combo_device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启动设备"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_device_container"
                android:includeFontPadding="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/combo_btn_task"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/btn_task_tonal"
        android:foreground="@drawable/widget_press_ripple">

        <ImageView
            android:id="@+id/combo_icon_task"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_task_star"
            android:tint="@color/widget_on_task_container"
            tools:ignore="ContentDescription,UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/combo_title_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="积分任务"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_task_container"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/combo_task_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="积分任务"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_task_container"
                android:includeFontPadding="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
