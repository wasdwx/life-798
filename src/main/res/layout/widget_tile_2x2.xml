<?xml version="1.0" encoding="utf-8"?>
<!-- 窄高和大尺寸小部件：文字可换行，空间足够时展示用水或任务详情。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/tile_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/btn_device_tonal"
        android:foreground="@drawable/widget_press_ripple"
        android:padding="12dp">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_water_drop"
            android:tint="@color/widget_on_device_container"
            tools:ignore="ContentDescription,UseAppTint" />

        <TextView
            android:id="@+id/tile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启动设备"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_on_device_container"
            android:gravity="center"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="15sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tile_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="待机"
            android:textSize="13sp"
            android:textColor="@color/widget_on_device_container"
            android:gravity="center"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tile_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="今日暂无用水"
            android:textSize="12sp"
            android:textColor="@color/widget_on_device_container"
            android:gravity="center"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="12sp"
            android:maxLines="2"
            android:visibility="gone"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
