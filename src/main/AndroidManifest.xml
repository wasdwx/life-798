<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quickie 使用 CameraX + ML Kit；覆盖 behind，保证设备扫码页始终竖屏。 -->
        <activity
            android:name="io.github.g00fy2.quickie.QRScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <activity
            android:name=".DeviceAddActivity"
            android:exported="false"
            android:label="添加设备" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="登录账户" />

        <activity
            android:name=".AccountsActivity"
            android:exported="false"
            android:label="账户管理" />

        <activity
            android:name=".ScoreActivity"
            android:exported="false"
            android:label="积分看板" />

        <activity
            android:name=".WalletActivity"
            android:exported="false"
            android:label="钱包充值" />

        <activity
            android:name=".AppearanceActivity"
            android:exported="false"
            android:label="外观设置" />

        <!-- 小部件在选择器里的名字来自 receiver 的 android:label；
             <appwidget-provider> 没有 label 属性，写在那儿会被静默忽略。 -->
        <receiver
            android:name=".WaterWidgetProvider"
            android:label="@string/widget_label_classic"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.water.widget.ACTION_START" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".ComboWidgetProvider"
            android:label="@string/widget_label_combo"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.water.widget.combo.START_DEVICE" />
                <action android:name="com.water.widget.combo.RUN_TASKS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combo_info" />
        </receiver>

        <receiver
            android:name=".DeviceWidgetProvider"
            android:label="@string/widget_label_device"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.water.widget.square.START_DEVICE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_square_device_info" />
        </receiver>

        <receiver
            android:name=".TaskWidgetProvider"
            android:label="@string/widget_label_task"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.water.widget.square.RUN_TASKS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_square_task_info" />
        </receiver>

        <service
            android:name=".WaterService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".TaskForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".WaterTileService"
            android:label="启动设备"
            android:icon="@drawable/ic_water_drop"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
